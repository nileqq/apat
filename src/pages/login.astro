---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Кіру" extraCss="/styles/auth.css">
  <main class="auth-main">
    <div class="auth-card">
      <div class="auth-header">
        <h1 class="auth-title" data-i18n="login_title">Кіру</h1>
        <p class="auth-sub" data-i18n="login_sub">Аккаунтыңызға кіріңіз</p>
      </div>

      <form class="auth-form" id="loginForm" novalidate>
        <div class="field-group">
          <label class="field-label" for="email" data-i18n="field_email">Электрондық пошта</label>
          <input class="field-input" type="email" id="email" name="email"
            autocomplete="email" placeholder="example@mail.com" data-i18n-ph="field_email_ph">
          <span class="field-error" id="emailError"></span>
        </div>

        <div class="field-group">
          <label class="field-label" for="password" data-i18n="field_password">Құпия сөз</label>
          <div class="password-wrapper">
            <input class="field-input" type="password" id="password" name="password"
              autocomplete="current-password" placeholder="••••••••" data-i18n-ph="field_password_ph">
            <button type="button" class="toggle-pass" id="togglePass" aria-label="Көрсету">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <span class="field-error" id="passwordError"></span>
        </div>

        <div id="formError" class="form-error" hidden></div>
        <button type="submit" class="auth-submit" data-i18n="login_submit">Кіру →</button>
      </form>

      <div class="auth-switch">
        <span data-i18n="login_no_account">Аккаунтыңыз жоқ па?</span>
        <a href="/register" data-i18n="login_register_link">Тіркелу</a>
      </div>
    </div>
  </main>

  <script src="/scripts/auth.js" slot="scripts"></script>
</Layout>
