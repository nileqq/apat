---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Qazaq Mura">
  <main style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 4rem 2rem;">
    <div style="text-align: center; max-width: 520px;">
      <h1 style="font-family: var(--font-serif); font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;">
        Тіл таңдаңыз
      </h1>
      <p style="font-size: 0.95rem; color: var(--color-muted); margin-bottom: 2.5rem; line-height: 1.6;">
        Сайтты қай тілде қарастыруды қалайсыз?
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <a href="/kk/" style="display: block; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-text); text-decoration: none; font-size: 1rem; font-weight: 500; transition: all 0.2s; border-color: var(--color-accent);">
          <strong>Қазақша</strong>
        </a>
        <a href="/ru/" style="display: block; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-text); text-decoration: none; font-size: 1rem; font-weight: 500; transition: all 0.2s;">
          <strong>Русский</strong>
        </a>
        <a href="/en/" style="display: block; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-text); text-decoration: none; font-size: 1rem; font-weight: 500; transition: all 0.2s;">
          <strong>English</strong>
        </a>
      </div>
    </div>
  </main>
</Layout>

