---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const languages = ['kk', 'ru', 'en'];
  return languages.map(lang => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;

const allArticles = await getCollection('articles');
const articles = allArticles
  .filter(a => a.collection === 'articles' && a.slug.startsWith(`${lang}/`) && !a.data.draft)
  .map(a => ({
    ...a,
    slug: a.slug.replace(`${lang}/`, ''),
  }))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, Record<string, string>> = {
  kk: { repression: 'Репрессия',  polygon: 'Полигон', famine: 'Голодомор' },
  ru: { repression: 'Репрессии',  polygon: 'Полигон', famine: 'Голодомор' },
  en: { repression: 'Repression', polygon: 'Polygon', famine: 'Famine'    },
};
const categoryLabel = categoryLabels[lang] ?? categoryLabels.kk;

const missionText: Record<string, string[]> = {
  kk: [
    'Ашаршылық (1930–1933), саяси қуғын-сүргін және Семей ядролық полигонынан зардап шеккендердің естеліктері арқылы қазақ халқының бастан кешкен тарихы мен қасіретін баяндаймыз.',
    'Біз әділетсіздік пен адам тағдырына жасалған қиянат туралы үнсіз қалмауға ұмтыламыз.',
    'Құрбандардың дауысы мен естеліктерін келешекке жеткізу арқылы әділдікке, тарихи жадыға және адам қадір-қасиетіне деген құрметті нығайтуды мақсат етеміз.',
  ],
  ru: [
    'Через воспоминания выживших в Голодоморе (1930–1933), политических репрессиях и ядерных испытаниях на Семипалатинском полигоне мы рассказываем об истории и трагедии казахского народа.',
    'Мы не можем молчать о несправедливости и о насилии, которому подверглись судьбы людей.',
    'Сохраняя голоса и воспоминания жертв для будущих поколений, мы стремимся укрепить уважение к справедливости, исторической памяти и человеческому достоинству.',
  ],
  en: [
    'Through the testimonies of survivors of the Famine (1930–1933), political repressions, and the Semipalatinsk nuclear test site, we tell the history and tragedy of the Kazakh people.',
    'We refuse to remain silent about injustice and the violence done to human lives.',
    'By preserving the voices and memories of victims for future generations, we seek to strengthen respect for justice, historical memory, and human dignity.',
  ],
};
const mission = missionText[lang] ?? missionText.kk;
---
<Layout title="Qazaq Mura" lang={lang}>

  <main>

    <!-- ─── Герой ─────────────────────────────── -->
    <section class="hero">
      <div class="hero-inner">

        <h1 class="hero-title">QAZAQ MURA</h1>

        <div class="hero-divider">
          <span class="divider-line"></span>
          <span class="divider-ornament">✦</span>
          <span class="divider-line"></span>
        </div>

        <p class="hero-subtitle">
          Қазақ халқының қайғысы мен қасіретіне арналған журнал
        </p>

        <div class="hero-mission">
          {mission.map(p => <p>{p}</p>)}
        </div>

        <div class="hero-search">
          <input type="text" id="searchInput" placeholder="Іздеу..." data-i18n-ph="search_placeholder">
          <button class="search-btn" aria-label="Іздеу">→</button>
        </div>

      </div>
    </section>

    <!-- ─── Статьи ─────────────────────────────── -->
    <section class="articles-section">
      <div class="articles-inner">

        <div class="articles-header">
          <div class="filter-pills">
            <button class="filter-pill active" data-filter="all"        data-i18n="filter_all">Барлығы</button>
            <button class="filter-pill"        data-filter="repression" data-i18n="tag_repression">Репрессия</button>
            <button class="filter-pill"        data-filter="polygon"    data-i18n="tag_polygon">Полигон</button>
            <button class="filter-pill"        data-filter="famine"     data-i18n="tag_famine">Голодомор</button>
          </div>
        </div>

        <div id="articleList">
          {articles.length > 0 ? (
            articles.map(article => (
              <a
                href={`/${lang}/articles/${article.slug}`}
                class="article-entry"
                data-category={article.data.category}
              >
                <div class="entry-meta">
                  <span class={`entry-eyebrow eyebrow-${article.data.category}`}>
                    {categoryLabel[article.data.category]}
                  </span>
                  <span class="entry-separator" aria-hidden="true">◆</span>
                  <span class="entry-date" data-date={article.data.date.toISOString().slice(0, 10)}>
                    {article.data.date.getFullYear()}
                  </span>
                </div>
                <h2 class="entry-title">
                  {article.data.title}{article.data.titleItalic ? ': ' : ''}
                  {article.data.titleItalic && <em>{article.data.titleItalic}</em>}
                </h2>
                <p class="entry-author">{article.data.author}</p>
                <p class="entry-excerpt">{article.data.excerpt}</p>
                <span class="entry-read" data-i18n="read_more">Оқу →</span>
              </a>
            ))
          ) : (
            <p class="articles-empty" data-i18n="articles_empty">Осы тілде мақалалар әлі жоқ</p>
          )}
        </div>

        <div id="searchResults" class="is-hidden"></div>

      </div>
    </section>

  </main>


  <script src="/scripts/main.js" slot="scripts"></script>
  <script src="/scripts/search.js" slot="scripts"></script>
</Layout>
