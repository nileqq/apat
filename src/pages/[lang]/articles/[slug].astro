---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const languages = ['kk', 'ru', 'en'];

  const paths: any[] = [];

  languages.forEach(lang => {
    articles
      .filter(a => a.slug.startsWith(`${lang}/`))
      .forEach(article => {
        const slug = article.slug.replace(`${lang}/`, '');
        paths.push({
          params: { lang, slug },
          props: { article },
        });
      });
  });

  return paths;
}

const { lang, slug } = Astro.params;
const { article } = Astro.props;
const { Content, headings } = await article.render();

const categoryTag: Record<string, string> = {
  repression: 'tag-repression',
  polygon:    'tag-polygon',
  famine:     'tag-famine',
};

const categoryLabel: Record<string, string> = {
  repression: 'Репрессия',
  polygon:    'Полигон',
  famine:     'Голодомор',
};

const tocHeadings = headings.filter(h => h.depth === 2);

const localeMap: Record<string, string> = { kk: 'kk-KZ', ru: 'ru-RU', en: 'en-US' };
const dateFormatted = article.data.date
  .toLocaleDateString(localeMap[lang] ?? 'ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })
  .toUpperCase();
---
<Layout title={article.data.title} extraCss="/styles/article.css" lang={lang}>

  <div class="reading-progress" id="readingProgress"></div>

  <main>
    {article.data.cover ? (
      <>
        <!-- Cover-фото шапка -->
        <div class="article-cover">
          <img src={article.data.cover} alt={article.data.title} class="article-cover-img">
          <div class="article-cover-overlay"></div>
          <div class="article-cover-content">
            {article.data.kicker && <p class="cover-kicker">{article.data.kicker}</p>}
            <div class="cover-tags">
              <span class="cover-tag">{categoryLabel[article.data.category]}</span>
            </div>
            <h1 class="article-title cover-title">
              {article.data.title}
              {article.data.titleItalic && <><br/><em>{article.data.titleItalic}</em></>}
            </h1>
            <p class="cover-byline">
              <span data-i18n="article_by">Автор:</span>
              <em>{article.data.author}</em>
            </p>
          </div>
        </div>
        <div class="cover-meta-bar">
          <span class="cover-date">{dateFormatted}</span>
          <span class="cover-cat-label">{categoryLabel[article.data.category]}</span>
        </div>
      </>
    ) : (
      <!-- Текстовая шапка (без фото) -->
      <div class="article-header">
        <div class="article-header-inner">
          <div class="article-meta-row">
            <span class={`article-tag ${categoryTag[article.data.category]}`}>
              {categoryLabel[article.data.category]}
            </span>
            <span class="article-vol">{article.data.volume ?? '2026'}</span>
          </div>
          <h1 class="article-title">
            {article.data.title}
            {article.data.titleItalic && <><br/><em>{article.data.titleItalic}</em></>}
          </h1>
          <p class="article-byline">
            <span data-i18n="article_by">Автор:</span>
            <span class="article-author">{article.data.author}</span>
          </p>
          <div class="article-rule">
            <span class="rule-line"></span>
            <span class="rule-ornament">✦</span>
            <span class="rule-line"></span>
          </div>
          <p class="article-abstract">{article.data.excerpt}</p>
        </div>
      </div>
    )}

    <!-- Мазмұн + Мәтін -->
    <div class="article-layout">

      <aside class="article-toc">
        <div class="toc-inner">
          <p class="toc-label" data-i18n="toc_label">Мазмұны</p>
          <nav>
            <ol class="toc-list">
              {tocHeadings.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`} class={`toc-link${i === 0 ? ' toc-active' : ''}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="toc-cite">
            <p class="cite-label" data-i18n="cite_label">Дәйексөз</p>
            <p class="cite-text">
              {article.data.author.split(' ')[0][0]}. «{article.data.title}».{' '}
              <em>Qazaq Mura</em>, {article.data.volume ?? '2026'}.
            </p>
          </div>
        </div>
      </aside>

      <article class="article-body">
        <Content />
      </article>
    </div>
  </main>

  <footer class="article-footer">
    <div class="article-footer-inner">
      <a href={`/${lang}`} class="back-link">
        <span>←</span>
        <span data-i18n="back_to_articles">Барлық мақалалар</span>
      </a>
      <span class="footer-copy">© 2026 Qazaq Mura</span>
    </div>
  </footer>

  <script src="/scripts/article.js" slot="scripts"></script>
</Layout>
