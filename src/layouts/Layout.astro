---
interface Props {
  title: string;
  extraCss?: string;
}
const { title, extraCss } = Astro.props;
---
<!DOCTYPE html>
<html lang="kk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Qazaq Mura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="/styles/header.css">
  {extraCss && <link rel="stylesheet" href={extraCss}>}
</head>
<body>
  <div id="root">
    <header>
      <div class="header-inner">
        <a href="/" class="logo">
          <img class="logo-mark" src="/assets/crow-white-transparent.png" alt="Qazaq Mura" height="44">
          <div class="logo-text">
            <span class="logo-title">Qazaq Mura</span>
            <span class="logo-sub">Естелік архиві</span>
          </div>
        </a>
        <nav>
          <a href="/" data-i18n="nav_articles">Мақалалар</a>
          <a href="/about" data-i18n="nav_about">Жоба туралы</a>
        </nav>
        <div class="lang-switcher">
          <button class="lang-btn active" data-lang="kk">ҚАЗ</button>
          <button class="lang-btn"        data-lang="ru">РУС</button>
          <button class="lang-btn"        data-lang="en">ENG</button>
        </div>
      </div>
    </header>

    <slot />

  </div>

  <script src="/scripts/i18n.js" is:inline></script>
  <script src="/scripts/session.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
