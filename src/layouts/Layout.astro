---
interface Props {
  title: string;
  extraCss?: string;
  lang?: string;
}
const { title, extraCss, lang = 'kk' } = Astro.props;

const themeToggleLabel: Record<string, string> = {
  kk: 'Түсті режимді ауыстыру',
  ru: 'Переключить тему',
  en: 'Toggle theme',
};

const navMenuLabel: Record<string, string> = {
  kk: 'Мәзірді ашу',
  ru: 'Открыть меню',
  en: 'Open menu',
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Qazaq Mura</title>
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('apat-theme');
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="/styles/header.css">
  {extraCss && <link rel="stylesheet" href={extraCss}>}
</head>
<body>
  <div id="root">
    <header>
      <div class="header-inner">
        <a href={`/${lang}/`} class="logo">
          <img class="logo-mark" src="/assets/logo.png" alt="Qazaq Mura" height="44">
          <div class="logo-text">
            <span class="logo-title">Qazaq Mura</span>
            <span class="logo-sub" data-i18n="logo_sub">Естелік архиві</span>
          </div>
        </a>
        <div class="lang-switcher">
          <button class={`lang-btn${lang === 'kk' ? ' active' : ''}`} data-lang="kk">ҚАЗ</button>
          <button class={`lang-btn${lang === 'ru' ? ' active' : ''}`} data-lang="ru">РУС</button>
          <button class={`lang-btn${lang === 'en' ? ' active' : ''}`} data-lang="en">ENG</button>
        </div>
      </div>
    </header>

    <div class="theme-reveal" id="themeReveal" aria-hidden="true"></div>

    <div class="nav-fab-wrap" id="navFabWrap">
      <div class="nav-fab-menu" id="navFabMenu">
        <a href={`/${lang}/`} data-i18n="nav_articles">Мақалалар</a>
        <a href={`/${lang}/works`} data-i18n="nav_works">Жұмыстар</a>
        <a href={`/${lang}/about`} data-i18n="nav_about">Жоба туралы</a>
        <button type="button" class="theme-toggle" id="themeToggle" aria-label={themeToggleLabel[lang] ?? themeToggleLabel.kk}>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <span>{themeToggleLabel[lang] ?? themeToggleLabel.kk}</span>
        </button>
      </div>
      <button type="button" class="nav-fab" id="navFabBtn" aria-haspopup="true" aria-expanded="false" aria-label={navMenuLabel[lang] ?? navMenuLabel.kk}>
        <svg class="icon-burger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>

    <slot />

    <footer class="journal-footer">
      <div class="journal-footer-inner">
        <div class="jf-top">
          <img src="/assets/logo.png" alt="" class="jf-logo-img">
          <h2 class="jf-title">QAZAQ MURA</h2>
          <p class="jf-tagline" data-i18n="hero_sub">
            Репрессия, полигон және голодомор құрбандарының тарихи куәліктері
          </p>
        </div>

        <div class="jf-divider"></div>

        <div class="jf-nav">
          <a href={`/${lang}/`} data-i18n="nav_articles">Мақалалар</a>
          <span class="jf-dot">·</span>
          <a href={`/${lang}/works`} data-i18n="nav_works">Жұмыстар</a>
          <span class="jf-dot">·</span>
          <a href={`/${lang}/about`} data-i18n="nav_about">Жоба туралы</a>
        </div>

        <div class="jf-social">
          <a href="https://www.instagram.com/qazaq.mura.journal" target="_blank" rel="noopener" class="jf-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            Instagram
          </a>
          <a href="mailto:qazaq.mura.journal@gmail.com" class="jf-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 6 10-6"/>
            </svg>
            qazaq.mura.journal@gmail.com
          </a>
        </div>

        <div class="jf-divider"></div>

        <p class="jf-copy">© 2026 Qazaq Mura · <span data-i18n="copyright">Барлық құқықтар қорғалған</span></p>
      </div>
    </footer>

  </div>

  <script src="/scripts/i18n.js" is:inline></script>
  <script src="/scripts/session.js" is:inline></script>
  <script src="/scripts/theme.js" is:inline></script>
  <script src="/scripts/nav.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
