---
interface Props {
  title: string;
  extraCss?: string;
  lang?: string;
}
const { title, extraCss, lang = 'kk' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — Qazaq Mura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/global.css">
  <link rel="stylesheet" href="/styles/header.css">
  {extraCss && <link rel="stylesheet" href={extraCss}>}
</head>
<body>
  <div id="root">
    <header>
      <div class="header-inner">
        <a href={`/${lang}/`} class="logo">
          <img class="logo-mark" src="/assets/crow-white-transparent.png" alt="Qazaq Mura" height="44">
          <div class="logo-text">
            <span class="logo-title">Qazaq Mura</span>
            <span class="logo-sub">Естелік архиві</span>
          </div>
        </a>
        <nav>
          <a href={`/${lang}/`} data-i18n="nav_articles">Мақалалар</a>
          <a href={`/${lang}/about`} data-i18n="nav_about">Жоба туралы</a>
        </nav>
        <div class="lang-switcher">
          <button class={`lang-btn${lang === 'kk' ? ' active' : ''}`} data-lang="kk">ҚАЗ</button>
          <button class={`lang-btn${lang === 'ru' ? ' active' : ''}`} data-lang="ru">РУС</button>
          <button class={`lang-btn${lang === 'en' ? ' active' : ''}`} data-lang="en">ENG</button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="journal-footer">
      <div class="journal-footer-inner">
        <div class="jf-top">
          <img src="/assets/crow-white-transparent.png" alt="" class="jf-logo-img">
          <h2 class="jf-title">QAZAQ MURA</h2>
          <p class="jf-tagline" data-i18n="hero_sub">
            Репрессия, полигон және голодомор құрбандарының тарихи куәліктері
          </p>
        </div>

        <div class="jf-divider"></div>

        <div class="jf-nav">
          <a href={`/${lang}/`} data-i18n="nav_articles">Мақалалар</a>
          <span class="jf-dot">·</span>
          <a href={`/${lang}/about`} data-i18n="nav_about">Жоба туралы</a>
        </div>

        <div class="jf-social">
          <a href="https://www.instagram.com/qazaq.mura.journal" target="_blank" rel="noopener" class="jf-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            Instagram
          </a>
        </div>

        <div class="jf-divider"></div>

        <p class="jf-copy">© 2026 Qazaq Mura · Барлық құқықтар қорғалған</p>
      </div>
    </footer>

  </div>

  <script src="/scripts/i18n.js" is:inline></script>
  <script src="/scripts/session.js" is:inline></script>
  <slot name="scripts" />
</body>
</html>
